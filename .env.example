# --- Fournisseur IA ---
# "gemini" (défaut) | "openai"
AI_PROVIDER="gemini"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o"

# --- Serveur ---
PORT="3001"
NODE_ENV="production"

# --- CORS ---
# URL(s) du frontend autorisées à appeler cette API (séparées par des virgules)
CORS_ORIGINS="https://verif237.vercel.app"
